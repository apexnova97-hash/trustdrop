# Paddle Billing (Sandbox first)
# Copy to .env.local and replace placeholders. Never commit real secrets.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_replace_me
PADDLE_PRICE_ID=pri_replace_with_your_19_month_price_id
PADDLE_WEBHOOK_SECRET=replace_with_paddle_notification_destination_secret
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_replace_with_paddle_client_side_token
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
SITE_URL=https://trustdrop-lac.vercel.app

# Existing Supabase public config
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Server-only: never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
